# Copy to .env and fill in. .env is gitignored; this file is not, so nothing secret
# belongs here.
#
#   cp .env.example .env
#
# Two consumers, and it matters which is which. Compose passes this file to the
# containers as `env_file`, and *separately* reads it for ${...} interpolation in
# docker-compose.yml. One consequence of the second: a literal `$` in a value has to
# be written `$$`, or compose will try to expand it and hand the container something
# shorter than your secret.
#
# On the host — running uvicorn or the worker directly — the same file is loaded with
# `set -a; source .env; set +a`, in every shell that needs it.


# --- Object storage (required) --------------------------------------------------
# Cloudflare R2 in practice; any S3-compatible endpoint works. site-service refuses to
# start with any of these empty and names the ones it is missing, rather than letting
# the mistake surface as a boto3 traceback on the first upload. The worker needs them
# too — it signs its own download URL for every video it opens.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# --- Docker Compose ---------------------------------------------------------------
# Your uid and gid, so files the containers write into data/ belong to you rather than
# to root. Compose does not run a shell over this file, so these have to be literal
# numbers — generate them with:
#
#   printf 'DOCKER_UID=%s\nDOCKER_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
DOCKER_UID=1000
DOCKER_GID=1000

# Where the published ports are reachable from. Loopback is the default for both, and
# on a workstation that is doing real work: the API has no authentication, and Redis
# in the official image has `protected-mode no`. Reach the API from another machine
# with `ssh -L 8001:localhost:8001 <workstation>` rather than by widening this.
# API_BIND=0.0.0.0
# REDIS_BIND=0.0.0.0

# Set only to point the stack at a Redis that already exists. Unset, compose wires
# api and worker to its own `redis` service.
# REDIS_URL=redis://redis:6379/0


# --- Detection ---------------------------------------------------------------------
# The ONNX export, as the *container* sees it. The default is the repo mount, so the
# file belongs at workers/detection-worker/models/rt-detr.onnx on the host. Weights
# are gitignored and never baked into the image.
# DETECTION_MODEL_PATH=/repo/workers/detection-worker/models/rt-detr.onnx

# Minimum confidence for a detection to leave the model at all — the coarsest filter
# in the pipeline, applied before tracking.
# DETECTION_THRESHOLD=0.5

# Left alone, each image sets its own: CUDA then CPU in the GPU image, CPU only in the
# CPU one. Worth knowing that this list is a *fallback* order, so a GPU image that
# cannot reach the card runs on CPU and only says so in its startup log.
# DETECTION_MODEL_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider


# --- Optional -----------------------------------------------------------------------
# S3_REGION=auto
# S3_PRESIGN_EXPIRY_SECONDS=3600
# S3_MAX_UPLOAD_BYTES=104857600
# DETECTION_QUEUE_NAME=detection:jobs
# VIDEO_PROBE_TIMEOUT_SECONDS=20
